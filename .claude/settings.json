{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(auth.json)",
      "Read(.npmrc)",
      "Edit(node_modules/**)",
      "Edit(vendor/**)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git push *--no-verify*)"
    ]
  }
}
