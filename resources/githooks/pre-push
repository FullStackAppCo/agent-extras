#!/usr/bin/env bash
#
# Pre-push hook.
#
# Enforces the branch (the `branch` skill) and tag (the `tag` skill) naming
# conventions by delegating to `php artisan agent-extras:validate-branch` and
# `php artisan agent-extras:validate-tag`, which print a descriptive error when
# a name breaks the rules.
#
# As a hook it validates every local branch and tag being pushed (stdin lines
# of `<local ref> <local sha> <remote ref> <remote sha>`). Run directly from a
# terminal (no piped stdin) to validate the current branch and every local tag
# instead.

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

if [ -t 0 ]; then
    # Run manually from a terminal: validate the current branch and all tags.
    artisan agent-extras:validate-branch
    artisan agent-extras:validate-tag
else
    # Run as a hook: validate each local branch and tag being pushed.
    while read -r local_ref _local_sha _remote_ref _remote_sha; do
        case "$local_ref" in
            refs/heads/*) artisan agent-extras:validate-branch "${local_ref#refs/heads/}" ;;
            refs/tags/*) artisan agent-extras:validate-tag "${local_ref#refs/tags/}" ;;
            *) ;; # deletions, etc.
        esac
    done
fi
