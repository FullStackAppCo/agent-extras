#!/usr/bin/env bash
#
# Pre-commit hook.
#
# Runs static analysis, refactoring, and formatting against the PHP files that
# are staged for commit — changed files only — via Herd, Sail or the host PHP
# (see lib.sh).

set -euo pipefail

# Collect staged PHP files (Added, Copied, Modified — deletions are skipped).
STAGED_FILES=()
while IFS= read -r file; do
    STAGED_FILES+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.php')

if [ ${#STAGED_FILES[@]} -eq 0 ]; then
    exit 0
fi

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

echo "→ refactor (${#STAGED_FILES[@]} changed PHP file(s))"
composer refactor -- "${STAGED_FILES[@]}"

echo "→ format"
composer format -- "${STAGED_FILES[@]}"

# Re-stage anything Rector or Pint rewrote so the fixes are part of the commit
# and analyze sees the final code.
git add -- "${STAGED_FILES[@]}"

echo "→ psr4 compliance"
composer check-psr4

echo "→ analyze"
composer analyze

echo "→ comment review"
COMMENTS="$(artisan agent-extras:nonessential-comments "${STAGED_FILES[@]}")"

if [ -z "$COMMENTS" ]; then
    exit 0
fi

if ! command -v claude >/dev/null 2>&1; then
    echo "  Claude Code is not installed — skipping the comment review." >&2
    exit 0
fi

# Unset CLAUDECODE so the review also runs when Claude Code itself commits.
if ! VERDICT="$(printf '%s\n' "$COMMENTS" | env -u CLAUDECODE claude -p \
    --model haiku \
    --tools "" \
    --strict-mcp-config \
    --system-prompt "$(cat "$(dirname "${BASH_SOURCE[0]}")/comment-review.md")" \
    "Review these added comments.")"; then
    echo "  The comment review failed to run — skipping it." >&2
    exit 0
fi

case "$(printf '%s\n' "$VERDICT" | head -n 1 | tr -d '[:space:]')" in
    PASS)
        ;;
    FAIL)
        echo "Comment review failed: these added comments add little value." >&2
        printf '%s\n' "$VERDICT" | tail -n +2 >&2
        echo "Remove them, or rewrite them to explain why the code is the way it is, then commit again." >&2
        exit 1
        ;;
    *)
        echo "  The comment review gave an unexpected reply — skipping it." >&2
        ;;
esac
