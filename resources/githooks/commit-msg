#!/usr/bin/env bash
#
# Commit-msg hook.
#
# Enforces the commit message convention (the `commit` skill) by delegating to
# `php artisan agent-extras:format-commit-message`, which strips the
# Claude-Session and Claude Co-Authored-By trailers and prints a descriptive
# error when the message breaks the rules.

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

# Git passes the message file as a path relative to the repository root, so it
# is inside the tree and can be used directly. In a linked worktree, however,
# git keeps the file in the *main* repository's .git and passes an absolute
# path, which is outside the tree Sail mounts into the container. Work on a
# copy inside the tree (vendor/ is always present and ignored) and write the
# result back.
case "$1" in
    "$ROOT"/*) artisan agent-extras:format-commit-message "${1#"$ROOT/"}" ;;
    /*)
        copy="$(mktemp "$ROOT/vendor/commit-msg.XXXXXX")"
        trap 'rm -f "$copy"' EXIT
        cp "$1" "$copy"
        artisan agent-extras:format-commit-message "${copy#"$ROOT/"}"
        cp "$copy" "$1"
        ;;
    *) artisan agent-extras:format-commit-message "$1" ;;
esac
